  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^15.8.0",
    "vite": "^6.0.7"
  }
}
