    "build": "vite build",
    "preview": "vite preview",
    "test:e2e:playwright": "playwright test",
    "test:e2e:playwright:ui": "playwright test --ui",
    "test:e2e:playwright:codegen": "playwright codegen http://127.0.0.1:8766/app/",
    "test:e2e:cypress": "env -u ELECTRON_RUN_AS_NODE cypress open --config baseUrl=http://127.0.0.1:8766/app",
