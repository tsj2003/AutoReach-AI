# ===========================================
# AutoReach-AI — Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# --- Database ---
# Production: set DATABASE_URL to Postgres. Dev may leave it blank and use AUTOREACH_DB.
DATABASE_URL=
AUTOREACH_DB=sqlite:///autoreach_engine.db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
AUTOREACH_WORKER_QUEUES=engine,maintenance,standard-agents

# --- Cockpit security ---
AUTOREACH_JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret
AUTOREACH_SESSION_SECRET=change-me-to-a-random-32-byte-minimum-secret
AUTOREACH_CREDENTIAL_ENCRYPTION_KEY=        # Fernet key; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOREACH_ENABLE_CONSOLE=0
AUTOREACH_RUNTIME_SMART_DISPATCH=0
AUTOREACH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTOREACH_PUBLIC_BASE_URL=                 # production URL, e.g. https://app.yourdomain.com

# --- Google OAuth / Gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SIGNIN_CLIENT_ID=
AUTOREACH_GMAIL_SENDER=you@yourdomain.com
AUTOREACH_GMAIL_TOKEN_PATH=token.json
AUTOREACH_GMAIL_DRY_RUN=1
AUTOREACH_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/google/callback
# Production mailbox OAuth redirect URI:
# https://YOUR_DOMAIN/api/mailboxes/connect/callback

# --- AI / LLMs ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=

# --- Reasoning ledger / OpenTelemetry ---
AUTOREACH_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# --- Intent ingestion ---
AUTOREACH_INTENT_DUCKDB_PATH=./intent.duckdb
AUTOREACH_INTENT_HOURS_BACK=24

# --- Billing ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# --- Calendar / webhooks ---
CALCOM_WEBHOOK_SECRET=

# --- Monitoring ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
