# ===========================================
# AutoReach-AI — Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# --- Database ---
# Production: set DATABASE_URL to Postgres. Dev may leave it blank and use AUTOREACH_DB.
DATABASE_URL=
AUTOREACH_DB=sqlite:///autoreach_engine.db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
AUTOREACH_WORKER_QUEUES=engine,maintenance,standard-agents

# --- Cockpit security ---
AUTOREACH_JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret
AUTOREACH_SESSION_SECRET=change-me-to-a-random-32-byte-minimum-secret
AUTOREACH_CREDENTIAL_ENCRYPTION_KEY=        # Fernet key; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOREACH_ENABLE_CONSOLE=0
AUTOREACH_RUNTIME_SMART_DISPATCH=0
AUTOREACH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTOREACH_PUBLIC_BASE_URL=                 # production URL, e.g. https://app.yourdomain.com

# --- Google OAuth / Gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LinkedIn OAuth (Sign In with LinkedIn / OpenID Connect) ---
# https://www.linkedin.com/developers/apps — enable Sign In with LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional; defaults to {origin}/api/linkedin/oauth/callback
LINKEDIN_OAUTH_REDIRECT_URI=
GOOGLE_SIGNIN_CLIENT_ID=
AUTOREACH_GMAIL_SENDER=you@yourdomain.com
AUTOREACH_GMAIL_TOKEN_PATH=token.json
AUTOREACH_GMAIL_DRY_RUN=1
AUTOREACH_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/google/callback
# Production mailbox OAuth redirect URI:
# https://YOUR_DOMAIN/api/mailboxes/connect/callback
# Production Google Calendar OAuth redirect URI (native meeting booking):
# https://YOUR_DOMAIN/api/calendar/connect/callback
# In Google Cloud Console → APIs & Services:
#   1) Enable "Google Calendar API"
#   2) OAuth consent screen: add scopes calendar.events (+ calendar.freebusy)
#   3) Credentials → OAuth client → Authorized redirect URIs for both callbacks above

# --- AI / LLMs ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://tarandeepjuneja11-9093-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Reasoning ledger / OpenTelemetry ---
AUTOREACH_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# --- Intent ingestion ---
AUTOREACH_INTENT_DUCKDB_PATH=./intent.duckdb
AUTOREACH_INTENT_HOURS_BACK=24

# --- Billing ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# --- Calendar / webhooks ---
CALCOM_WEBHOOK_SECRET=

# --- Monitoring ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Firecrawl (web scraping for website-read + lead sourcing) — https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Enrichment / signals (defaults fail-closed where noted) ---
AUTOREACH_SIGNALS_ENABLED=1
AUTOREACH_ENRICHMENT_ENABLED=1
AUTOREACH_LEARNING_ENABLED=1
AUTOREACH_REPLY_AI_ENABLED=1
AUTOREACH_ENGINE_PAUSED=0
HUNTER_API_KEY=                            # optional; HunterProvider stays NOT_CONFIGURED without it
