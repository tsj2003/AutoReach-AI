# ===========================================
# AutoReach-AI — Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# --- Database ---
# PostgreSQL connection string for production
# SQLite fallback: sqlite:///autoreach_saas.db (dev only)
DATABASE_URL=postgresql://user:password@localhost:5432/autoreach

# --- Redis (Celery Broker + Result Backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Flask ---
SECRET_KEY=change-me-to-a-random-secret
FLASK_ENV=development

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Gemini AI ---
GEMINI_API_KEY=

# --- SMTP Alert Pipeline ---
SYSTEM_SMTP_HOST=smtp.gmail.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_FROM_EMAIL=alerts@autoreach-ai.com

# --- Sentry Error Monitoring ---
SENTRY_DSN=

# --- PostHog Product Analytics ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- App Domain (for unsubscribe URLs) ---
APP_DOMAIN=localhost:8080
